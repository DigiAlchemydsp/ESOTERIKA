{
 "elemod": 2,
 "id": "esoterika",
 "version": "1.0",
 "title": "ESOTERIKA",
 "description": "ESOTERIKA container for the Digitone mk1 (OS 1.44). Owns the one master-view draw site, appends every registered pack page to the page cycle, dispatches the active page's draw/enc/tick, handles LEFT/RIGHT page navigation, tracks FUNC for encoder snapping, and runs one output ceiling after the guest FX chains. Includes the ESOTERIKA crystal-ball boot splash (intro present hooks). Has no page of its own. Requires the core (core-dn1 4.0); does not include it. Install ESOTERIKA plus any combination of guest packs (RUIN, XTAL, ...).",
 "category": "Sound",
 "author": "Digital Alchemy DSP",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
